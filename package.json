    "dompurify": "^3.2.6",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.468.0",
    "marked": "^13.0.3",
    "nanoid": "^5.0.7",
    "pinia": "^2.3.1",
    "tsx": "^4.19.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/dompurify": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
